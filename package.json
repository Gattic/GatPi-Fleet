{
  "name": "pi-dash",
  "version": "0.1.0",
  "description": "Dashboard and manager TUI for running pi sessions",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "pi-dash": "bin/pi-dash",
    "pi-dash-server": "bin/pi-dash-server",
    "pi-dash-server-start": "bin/pi-dash-server-start",
    "pi-dash-server-stop": "bin/pi-dash-server-stop"
  },
  "pi": {
    "extensions": [
      "./src/bridge/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/dashboard/main.ts",
    "server": "node src/server/main.ts",
    "check:android": "cd android && ./gradlew --no-daemon --max-workers=2 testDebugUnitTest lintDebug assembleDebug assembleDebugAndroidTest",
    "api:generate": "node scripts/export-api.ts",
    "check": "tsc -p tsconfig.json",
    "test": "node --test --test-reporter=spec 'test/*.test.ts'",
    "test:e2e": "node --test --test-reporter=spec 'test/e2e/*.test.ts'"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^22.19.0",
    "@types/ws": "8.18.1",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
