# screenrc for pi sessions launched by pi-dash: one window running pi,
# no extra windows. Settings mirror ~/.screenrc-empty.
defdynamictitle off
startup_message off
altscreen on
autodetach on
defscrollback 100000

bell_msg "Bell in %n (%t)"
vbell on
vbell_msg "Bell in %n (%t)"

caption always "%{=b 15;4}%n %t %h %=%l %H %c%{-}"
hardstatus alwayslastline "%{= 7;0}%-Lw%{=b 15;4}%n %f* %t%{-}%{= 7;0}%+Lw%<%{-}"

activity "Activity in %t(%n)"
activity_timeout 2

term screen-256color
defbce on
attrcolor b ".I"
msgwait 1
defautonuke off
defmonitor on
multiuser on

termcapinfo xterm* ti@:te@
termcapinfo xterm* km
