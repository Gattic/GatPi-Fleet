# Shared settings sourced by screenrc-4 and screenrc-5; no extra windows.
# Host-specific settings belong in $XDG_CONFIG_HOME/pi-dash/screenrc
# (normally ~/.config/pi-dash/screenrc).
defdynamictitle off
startup_message off
altscreen on
autodetach on
defscrollback 100000

bell_msg "Bell in %n (%t)"
vbell on
vbell_msg "Bell in %n (%t)"

activity "Activity in %t(%n)"
activity_timeout 2

term screen-256color
# Keep the terminal name matched by Ubuntu/Mint's *-256color prompt detection.
defbce off
attrcolor b ".I"
msgwait 1
defautonuke off
defmonitor on
multiuser on

termcapinfo xterm* ti@:te@
termcapinfo xterm* km
